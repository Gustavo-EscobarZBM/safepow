# Aplicação
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL — role ADMINISTRADOR (dono das tabelas).
# Usado apenas para rodar migrations (npm run migration:run) — nunca pelo servidor em runtime.
DB_HOST=localhost
# 5433: é a porta que o docker-compose.yml publica para o Postgres do container.
DB_PORT=5433
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres_admin_local_only
DB_NAME=inventory_saas
DB_SSL=false

# Banco de dados PostgreSQL — role de RUNTIME da aplicação (sem SUPERUSER, sem
# ser dono das tabelas — é nele que a Row Level Security realmente se aplica).
# Criado automaticamente pelo docker-compose via docker/init-db/001-create-app-role.sql.
DB_APP_USER=inventory_saas_app
DB_APP_PASSWORD=change-me-app-role-password

# JWT
JWT_SECRET=troque-este-valor-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=8h

# Usuário master inicial (criado pelo seed) — troque a senha antes de rodar em produção
MASTER_ADMIN_EMAIL=master@seusistema.com.br
MASTER_ADMIN_PASSWORD=troque-esta-senha

# Object storage S3-compatível (Seção 2.3 do documento — DigitalOcean Spaces,
# AWS S3, Cloudflare R2, MinIO local para dev, etc.). Valores do MinIO do docker-compose.yml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=inventory-saas-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/inventory-saas-uploads
STORAGE_FORCE_PATH_STYLE=true

# Redis (fila de importação de planilhas — Seção 5 do documento)
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe (cobrança recorrente — Seção 6.3 do documento)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# API e arquivos: 127.0.0.1 = somente este PC/USB. O menu Configurar Wi-Fi habilita acesso pela rede local.
API_BIND_ADDRESS=127.0.0.1
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Contas de demonstracao: gerente.demo@safepow.com / 123456; funcionario.demo@safepow.com / demo1234.
SAFEPOW_SEED_DEMO=true
