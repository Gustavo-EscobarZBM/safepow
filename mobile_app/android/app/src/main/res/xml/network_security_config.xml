<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfego HTTP puro (sem TLS) só para os hosts de desenvolvimento
  local — o Android bloqueia cleartext por padrão desde a API 28. Em
  produção o backend deve ficar atrás de HTTPS e este arquivo deixa de ser
  necessário (ou passa a listar só o domínio real, se ainda for preciso).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
