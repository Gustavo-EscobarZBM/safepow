# URL do backend (Fase 1/2 do documento de arquitetura). O painel web nunca
# expõe isso ao navegador diretamente — todas as chamadas passam pelo proxy
# em src/app/api/backend/[...path]/route.ts, que roda no servidor Next.js.
BACKEND_URL=http://localhost:3000/api

# Nome do cookie httpOnly que guarda o token JWT (não acessível via JS no navegador).
SESSION_COOKIE_NAME=inv_saas_session
